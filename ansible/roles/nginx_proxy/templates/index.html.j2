<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Remote Access Gateway</title>
    <style>
        :root {
            --bg: #eef4fb;
            --panel: #ffffff;
            --text: #152238;
            --muted: #607089;
            --accent: #2f7dd1;
            --accent-soft: #dcecff;
            --border: #c9d8ea;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 24px;
            background:
                radial-gradient(circle at 20% 20%, rgba(47, 125, 209, 0.16), transparent 32%),
                linear-gradient(145deg, var(--bg), #ffffff);
            color: var(--text);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        main {
            width: min(680px, 100%);
            padding: 32px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.94);
            box-shadow: 0 18px 48px rgba(21, 34, 56, 0.12);
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 8px;
            background: var(--accent-soft);
            color: var(--accent);
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        h1 {
            margin: 18px 0 12px;
            font-size: clamp(28px, 5vw, 42px);
            line-height: 1.08;
        }

        p {
            margin: 0;
            color: var(--muted);
            line-height: 1.6;
            font-size: 16px;
        }

        dl {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
            margin: 24px 0 0;
        }

        div {
            padding: 14px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: #f8fbff;
        }

        dt {
            margin: 0 0 6px;
            color: var(--muted);
            font-size: 13px;
        }

        dd {
            margin: 0;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <main>
        <span class="badge">Protected Remote Access</span>
        <h1>Gateway is running</h1>
        <p>
            This endpoint is reserved for the protected remote access service.
            Use the configured bot or web cabinet to manage access and retrieve client configurations.
        </p>
        <dl>
            <div>
                <dt>Role</dt>
                <dd>Reverse proxy</dd>
            </div>
            <div>
                <dt>Managed by</dt>
                <dd>Ansible</dd>
            </div>
        </dl>
    </main>
</body>
</html>
