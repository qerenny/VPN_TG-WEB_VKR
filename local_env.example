vpn_locations:
  netherlands:
    label: "🇳🇱Нидерланды"
  germany:
    label: "🇩🇪Германия"

servers:
  netherlands:
    username: "your_username_here"
    password: "your_password_here"
    domain: "vpn-node.example.com"
    port: "592"
    path: "your_path_here"
    subscription_port: "764"
    subscription_path: "your_subscription_path_here"
    inbounds:
      1: "netherlands"
    inbound_id: 1
  # germany:
  #   username: ""
  #   password: ""
  #   domain: ""
  #   port: ""
  #   path: ""
  #   subscription_port: ""
  #   subscription_path: ""
  #   inbounds:
  #     2: "germany"
  #   inbound_id: 2
    
inbound:
  amount_of_devices: 5

product:
  name: "Remote Access Service"
  short_name: "Remote Access"
  description: "Automated protected remote access service"
  redis_prefix: "remote_access"
  cookie_prefix: "remote_access"
  profile_tag: "🔐"
  profile_title: "Remote Access"
  traffic_profile_title: "Traffic-Limited Remote Access"
  announce: ""
  support_name: "Support"
  support_link: "https://t.me/your_support_username"
  docs_links:
    faq: "https://docs.example.com/faq/"
    devices: "https://docs.example.com/devices/"
    about: "https://docs.example.com/"

features:
  commerce_enabled: true
  referrals_enabled: true
  promos_enabled: true
  web_purchase_enabled: true
  telegram_bot_enabled: true
  telegram_proxy_enabled: true
  traffic_limited_config_enabled: true

deploy:
  project_slug: "remote-access-service"
  remote_app_dir: "$HOME/remote-access-service"
  backup_dir: "$HOME/remote-access-service-backups"
  frontend_public_dir: "/var/www/remote-access-service"
  container_prefix: "remote-access"
  image_prefix: "ghcr.io/example/remote-access-service"
  config_env_var: "APP_CONFIG_PATH"
  postgres_db: "remote_access"
  postgres_user: "remote_access"

plans:
  - code: "trial_3d"
    legacy_payload: "day3"
    name: "Пробный доступ на 3 дня"
    kind: "trial"
    scope: "standard"
    entitlement_kind: "time"
    duration_days: 3
    quota_bytes:
    price_amount:
    currency:
    is_active: true
  - code: "news_bonus_4d"
    legacy_payload: "day4"
    name: "Бонусный доступ на 4 дня"
    kind: "bonus"
    scope: "standard"
    entitlement_kind: "time"
    duration_days: 4
    quota_bytes:
    price_amount:
    currency:
    is_active: true
  - code: "month_1"
    legacy_payload: "month1"
    name: "Доступ на 1 месяц"
    kind: "paid"
    scope: "standard"
    entitlement_kind: "time"
    duration_days: 30
    quota_bytes:
    price_amount: "169.00"
    currency: "RUB"
    is_active: true
  - code: "month_3"
    legacy_payload: "month3"
    name: "Доступ на 3 месяца"
    kind: "paid"
    scope: "standard"
    entitlement_kind: "time"
    duration_days: 90
    quota_bytes:
    price_amount: "449.00"
    currency: "RUB"
    is_active: true
  - code: "month_6"
    legacy_payload: "month6"
    name: "Доступ на 6 месяцев"
    kind: "paid"
    scope: "standard"
    entitlement_kind: "time"
    duration_days: 180
    quota_bytes:
    price_amount: "799.00"
    currency: "RUB"
    is_active: true
  - code: "year_1"
    legacy_payload: "year1"
    name: "Доступ на 12 месяцев"
    kind: "paid"
    scope: "standard"
    entitlement_kind: "time"
    duration_days: 365
    quota_bytes:
    price_amount: "1490.00"
    currency: "RUB"
    is_active: true
  - code: "whitelist_trial_2gb"
    legacy_payload: "whitelist_trial_2gb"
    name: "Пробная конфигурация с лимитом 2 GB"
    kind: "trial"
    scope: "whitelist"
    entitlement_kind: "traffic"
    duration_days: 3
    quota_bytes: 2147483648
    price_amount:
    currency:
    is_active: false
  - code: "whitelist_15gb"
    legacy_payload: "whitelist15gb"
    name: "Конфигурация с лимитом 15 GB"
    kind: "paid"
    scope: "whitelist"
    entitlement_kind: "traffic"
    duration_days: 30
    quota_bytes: 16106127360
    price_amount: "99.00"
    currency: "RUB"
    is_active: true
  - code: "whitelist_35gb"
    legacy_payload: "whitelist35gb"
    name: "Конфигурация с лимитом 35 GB"
    kind: "paid"
    scope: "whitelist"
    entitlement_kind: "traffic"
    duration_days: 45
    quota_bytes: 37580963840
    price_amount: "249.00"
    currency: "RUB"
    is_active: true
  - code: "whitelist_80gb"
    legacy_payload: "whitelist80gb"
    name: "Конфигурация с лимитом 80 GB"
    kind: "paid"
    scope: "whitelist"
    entitlement_kind: "traffic"
    duration_days: 60
    quota_bytes: 85899345920
    price_amount: "499.00"
    currency: "RUB"
    is_active: true

# Optional real provider sections are intentionally omitted in the default
# diploma/open-source config. The application uses demo external gateways below.
# cryptopay:
#   token: "your_cryptopay_token_here"
#
# yookassa:
#   account_id: "your_account_id_here"
#   secret_key: "your_secret_key_here"

bot:
  tg_id: "your_bot_username"
  api: "your_telegram_api_token_here"
  admin_ids: "[123456789, 987654321]" 
  bonus_referrer: 7
  bonus_new_user: 5
  news_channel: "your_news_channel"
  news_channel_id: "-1000000000000"
  support: "your_support_username"

referrals:
  default_referrer_bonus_days: 7
  referrer_bonus_rules:
    3: 10
    5: 15
    10: 31
    15: 62

images:
  subscriptions: "your_telegram_file_id_here"
  instructions: "your_telegram_file_id_here"
  menu: "your_telegram_file_id_here"
  my_subscription: "your_telegram_file_id_here"
  help: "your_telegram_file_id_here"
  referral_program: "your_telegram_file_id_here"

db:
  name: "remote_access"
  username: "your_db_username"
  password: "your_db_password"
  host: "localhost"
  sql_echo: false

frontend:
  link: "http://localhost:5173"
  admin_path: "change-me-private-admin-path"
  subscription_link: "http://localhost:5173/subscription"
  # Optional public URL for Telegram buttons in local/dev environments.
  # If omitted and subscription_link points to localhost/private IP, the bot hides the button.
  telegram_subscription_link: "https://your-public-dev-url.example/subscription"
  faq_link: "https://docs.example.com/faq/"
  devices_link: "https://docs.example.com/devices/"
  about_link: "https://docs.example.com/"
  telegram_proxy_url: "tg://proxy?server=telegram-proxy.example.com&port=8443&secret=replace_me"
  happ_subscription_add_link: "happ://add/"
  app_link_happ_ios: "https://apps.apple.com/ru/app/happ-proxy-utility-plus/id6746188973"
  app_link_happ_android: "https://play.google.com/store/apps/details?id=com.happproxy"
  app_link_happ_windows: "https://github.com/Happ-proxy/happ-desktop/releases/latest/download/setup-Happ.x64.exe"
  app_link_happ_macos: "https://apps.apple.com/ru/app/happ-proxy-utility-plus/id6746188973"
  app_link_happ_linux: "https://www.happ.su/main/ru"
  app_link_windows_nekoray: "https://github.com/MatsuriDayo/nekoray/releases/download/4.0.1/nekoray-4.0.1-2024-12-12-windows64.zip"
  instruction_link_ios: "https://docs.example.com/devices/ios.html"
  instruction_link_android: "https://docs.example.com/devices/android.html"
  instruction_link_windows: "https://docs.example.com/devices/windows.html"
  instruction_link_macos: "https://docs.example.com/devices/macos.html"
  instruction_link_linux: "https://docs.example.com/devices/linux.html"
  instruction_link_windows_nekoray: "https://docs.example.com/devices/windows-nekoray.html"

backend:
  subscription_link: "http://0.0.0.0:8000/TnRawd31rfdqwaGtY7oZ/subscription/build"
  # Optional public URL for subscription links that are shown inside Telegram/public frontend.
  telegram_subscription_link: "https://api.your-public-dev-url.example/TnRawd31rfdqwaGtY7oZ/subscription/build"
  prefix: "/TnRawd31rfdqwaGtY7oZ"

admin:
  enabled: true
  token: "set_strong_admin_token_here"
  default_role: "superadmin"
  session_ttl_minutes: 480
  login_attempt_window_seconds: 900
  login_max_attempts: 5
  login_lockout_seconds: 1800

auth:
  web_session_ttl_minutes: 43200
  email_code_ttl_minutes: 15
  identity_link_token_ttl_minutes: 30
  challenge_resend_cooldown_seconds: 60
  challenge_request_window_seconds: 3600
  challenge_max_requests_per_window_per_email: 5
  challenge_max_requests_per_window_per_ip: 20
  challenge_max_failed_attempts: 5
  password_min_length: 8

mail:
  enabled: true
  provider: "smtp"
  from_email: "noreply@example.com"
  from_name: "Remote Access Service"
  reply_to: ""
  smtp_host: "smtp.example.com"
  smtp_port: 587
  smtp_username: "smtp-user"
  smtp_password: "smtp-password"
  smtp_starttls: true
  smtp_ssl: false
  timeout_seconds: 10

redis:
  url: "redis://localhost:6379/0"
  subscription_build_ttl: 60
  subscription_info_ttl: 30
  reminder_ready_queue_key: "remote_access:queue:subscription_reminders:ready"
  reminder_retry_queue_key: "remote_access:queue:subscription_reminders:retry"
  reminder_dead_letter_queue_key: "remote_access:queue:subscription_reminders:dead_letter"
  reminder_dedupe_prefix: "remote_access:queue:subscription_reminders:dedupe"
  reminder_dedupe_ttl_seconds: 172800
  reminder_scan_interval_seconds: 300
  reminder_lookahead_hours: 24
  reminder_retry_base_seconds: 30
  reminder_max_retries: 3
  reminder_worker_pop_timeout_seconds: 5
  payment_ready_queue_key: "remote_access:queue:payments:ready"
  payment_retry_queue_key: "remote_access:queue:payments:retry"
  payment_dead_letter_queue_key: "remote_access:queue:payments:dead_letter"
  payment_dedupe_prefix: "remote_access:queue:payments:dedupe"
  payment_dedupe_ttl_seconds: 120
  payment_retry_base_seconds: 30
  payment_max_retries: 8
  payment_scan_interval_seconds: 30
  payment_worker_pop_timeout_seconds: 5
  payment_status_scan_interval_seconds: 30

payments:
  webhook_token: "set_random_secret_token_here"
  card_gateway_code: "external_card"
  card_gateway_label: "Банковская карта"
  wallet_gateway_code: "external_wallet"
  wallet_gateway_label: "Электронный кошелёк"
  demo_checkout_path: "/demo-payment"
  demo_auto_paid: true

jwt:
  secret: "your_jwt_secret_key_here"
  algorithm: "HS256"
  exp_min: 60

logger:
  telegram_token: "your_logger_telegram_token_here"
  telegram_chat_id: 123456789

sentry:
  dsn: "your_sentry_dsn_here"
