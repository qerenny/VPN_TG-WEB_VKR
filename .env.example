# Required before first real run
# Environment variables with group prefixes like BOT__ / DB__ / PRODUCT__
# override values from this file.
# Optional file-based overrides can live in .env.override
# or in a custom file referenced by REMOTE_ACCESS_CONFIG_OVERRIDE_PATH.
# Set module flags first. Server blocks below are required only
# for the modules you leave enabled.

FEATURES__STANDARD_CONFIG_ENABLED=true
FEATURES__TRAFFIC_LIMITED_CONFIG_ENABLED=true

# Required when FEATURES__STANDARD_CONFIG_ENABLED=true
SERVERS__GERMANY__USERNAME="__REQUIRED_SERVER_USERNAME__"
SERVERS__GERMANY__PASSWORD="__REQUIRED_SERVER_PASSWORD__"
SERVERS__GERMANY__DOMAIN="__REQUIRED_SERVER_DOMAIN__"
SERVERS__GERMANY__PORT="592"
SERVERS__GERMANY__PATH="__REQUIRED_SERVER_API_PATH__"
SERVERS__GERMANY__SUBSCRIPTION_PORT="764"
SERVERS__GERMANY__SUBSCRIPTION_PATH="__REQUIRED_SERVER_SUBSCRIPTION_PATH__"
SERVERS__GERMANY__INBOUNDS__3="germany"
SERVERS__GERMANY__INBOUND_ID=3
# Required when FEATURES__TRAFFIC_LIMITED_CONFIG_ENABLED=true
TRAFFIC_LIMITED_SERVERS__NETHERLANDS__USERNAME="__REQUIRED_TRAFFIC_SERVER_USERNAME__"
TRAFFIC_LIMITED_SERVERS__NETHERLANDS__PASSWORD="__REQUIRED_TRAFFIC_SERVER_PASSWORD__"
TRAFFIC_LIMITED_SERVERS__NETHERLANDS__DOMAIN="__REQUIRED_TRAFFIC_SERVER_DOMAIN__"
TRAFFIC_LIMITED_SERVERS__NETHERLANDS__PORT="592"
TRAFFIC_LIMITED_SERVERS__NETHERLANDS__PATH="__REQUIRED_TRAFFIC_SERVER_API_PATH__"
TRAFFIC_LIMITED_SERVERS__NETHERLANDS__SUBSCRIPTION_PORT="764"
TRAFFIC_LIMITED_SERVERS__NETHERLANDS__SUBSCRIPTION_PATH="__REQUIRED_TRAFFIC_SERVER_SUBSCRIPTION_PATH__"
TRAFFIC_LIMITED_SERVERS__NETHERLANDS__INBOUNDS__5="netherlands"
TRAFFIC_LIMITED_SERVERS__NETHERLANDS__INBOUND_ID=5
BOT__TG_ID="__REQUIRED_BOT_USERNAME__"
BOT__API="123456:__REQUIRED_BOT_TOKEN__"
BOT__ADMIN_IDS="[123456789]"
BOT__INFO_CHANNEL=""
BOT__INFO_CHANNEL_ID=""
BOT__SUPPORT="__REQUIRED_SUPPORT_USERNAME__"
DB__NAME="remote_access"
DB__USERNAME="__REQUIRED_DB_USERNAME__"
DB__PASSWORD="__REQUIRED_DB_PASSWORD__"
DB__HOST="localhost"
FRONTEND__ADMIN_PATH="__REQUIRED_PRIVATE_ADMIN_PATH__"
ADMIN__TOKEN="__REQUIRED_ADMIN_TOKEN__"
PAYMENTS__WEBHOOK_TOKEN="__REQUIRED_PAYMENTS_WEBHOOK_TOKEN__"
