DEPLOY__IMAGE_PREFIX="ghcr.io/example/remote-access-service"
DEPLOY__CONFIG_ENV_VAR="REMOTE_ACCESS_CONFIG_PATH"
DEPLOY__POSTGRES_DB="remote_access"
DEPLOY__POSTGRES_USER="remote_access"

