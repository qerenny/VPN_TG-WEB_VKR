VPN_LOCATIONS__GERMANY__LABEL="🇩🇪Германия"

# Inbound settings
INBOUND__AMOUNT_OF_DEVICES=5

# Product settings
PRODUCT__NAME="Remote Access Service"
PRODUCT__SHORT_NAME="Remote Access"
PRODUCT__DESCRIPTION="Automated protected remote access service"
PRODUCT__REDIS_PREFIX="remote_access"
PRODUCT__COOKIE_PREFIX="remote_access"
