# Optional file-based overrides.
# Copy this file to .env.override and leave only values that should differ
# from the base config file selected by REMOTE_ACCESS_CONFIG_PATH.
#
# Load order:
# 1. base file from REMOTE_ACCESS_CONFIG_PATH or auto-detected .env.local/.env/.env.production
# 2. .env.override from the same directory, or REMOTE_ACCESS_CONFIG_OVERRIDE_PATH if set
# 3. process environment variables with group prefixes like BOT__ / DB__ / PRODUCT__
#
# This file is useful for local secrets, machine-specific paths, temporary feature switches,
# and values that should not be committed into .env.example.

# BOT__API="123456:REAL_BOT_TOKEN"
# BOT__ADMIN_IDS="[111111111,222222222]"
# ADMIN__TOKEN="replace-me"
# JWT__SECRET="replace-me"
# MAIL__ENABLED=true
# MAIL__PROVIDER="smtp"
# MAIL__SMTP_HOST="smtp.example.com"
# MAIL__SMTP_PORT=465
# MAIL__SMTP_SSL=true
# MAIL__SMTP_USERNAME="smtp-user"
# MAIL__SMTP_PASSWORD="smtp-password"
# MAIL__FROM_EMAIL="noreply@example.com"
# IMAGES__MENU="AgACAgIAAxkBA..."
# IMAGES__SUBSCRIPTIONS="AgACAgIAAxkBA..."
# FEATURES__COMMERCE_ENABLED=false
# FEATURES__ACCESS_REQUESTS_ENABLED=true
# FEATURES__ACCESS_REGISTRY_ENABLED=true
# FEATURES__ACCESS_ADMIN_OVERRIDE_ENABLED=true
# FEATURES__MAIL_ENABLED=false
# FEATURES__STANDARD_CONFIG_ENABLED=true
# FEATURES__TRAFFIC_LIMITED_CONFIG_ENABLED=false
# SERVERS__GERMANY__INBOUNDS__3="germany"
# TRAFFIC_LIMITED_SERVERS__GERMANY__DOMAIN="traffic.example.com"
# TRAFFIC_LIMITED_SERVERS__GERMANY__INBOUNDS__7="germany"
