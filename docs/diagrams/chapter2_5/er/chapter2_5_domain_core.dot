      <TR><TD ALIGN="LEFT">code</TD></TR>
      <TR><TD ALIGN="LEFT">label</TD></TR>
    </TABLE>
  >];

  vpn_control_planes [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6">
