      <TR><TD ALIGN="LEFT">location_id (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">scope</TD></TR>
      <TR><TD ALIGN="LEFT">kind</TD></TR>
    </TABLE>
  >];

  vpn_client_deployments [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6">
      <TR><TD BGCOLOR="#e7dff7"><B>vpn_client_deployments</B></TD></TR>
      <TR><TD ALIGN="LEFT"><U>id</U></TD></TR>
      <TR><TD ALIGN="LEFT">vpn_client_id (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">access_point_id (FK)</TD></TR>
