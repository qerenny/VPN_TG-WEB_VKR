digraph chapter2_5_domain_core {
  graph [
    rankdir=TB,
    splines=ortho,
    nodesep=0.35,
    ranksep=0.55,
    pad=0.2,
    bgcolor="white",
    fontname="Times New Roman",
    fontsize=14
  ];

  node [shape=plain, fontname="Times New Roman"];
  edge [arrowhead=none, color="#444444", penwidth=1.2];

  users [label=<
