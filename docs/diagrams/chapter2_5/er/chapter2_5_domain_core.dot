  { rank=same; telegram_accounts; users; web_accounts; identity_link_tokens; }
  { rank=same; access_registry_entries; access_requests; access_grants; }
  { rank=same; plans; subscription_state; subscription_grants; vpn_clients; }
  { rank=same; vpn_locations; vpn_control_planes; vpn_access_points; vpn_client_deployments; traffic_state; traffic_grants; }

  telegram_accounts -> users;
  web_accounts -> users;
  identity_link_tokens -> users;

  access_requests -> users;
  access_requests -> access_grants;
  access_grants -> users;
  access_grants -> plans;

  subscription_state -> users;
  subscription_grants -> users;
  subscription_grants -> plans;

  vpn_clients -> users;
  traffic_state -> vpn_clients;
  traffic_grants -> users;
  traffic_grants -> vpn_clients;
  traffic_grants -> plans;

  vpn_access_points -> vpn_control_planes;
  vpn_access_points -> vpn_locations;
  vpn_client_deployments -> vpn_clients;
