@startuml chapter2_3_component_angled_service_deps
left to right direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 60

package "Автоматизированный сервис\nзащищённого удалённого доступа" as Service {
  component "Frontend\n(web-кабинет,\nadmin-панель)" as Frontend <<component>>
  component "Backend\n(HTTP API)" as Backend <<component>>
  component "Telegram-бот\n(пользовательский канал\nи фоновые процессы)" as Bot <<component>>
  component "Shared\n(общий доменный\nи инфраструктурный слой)" as Shared <<library>>
  component "Alembic\n(миграции схемы БД)" as Alembic <<component>>

  Frontend -[hidden]down- Backend
  Backend -[hidden]down- Bot
  Bot -[hidden]down- Shared
  Shared -[hidden]down- Alembic
}

package "Инфраструктурные зависимости" as InfraDeps {
  database "PostgreSQL\n(доменное состояние)" as PostgreSQL <<database>>
  database "Redis\n(кэш и очереди)" as Redis <<database>>

  PostgreSQL -[hidden]down- Redis
}

package "Внешние системы" as External {
  component "Платёжный шлюз" as PaymentGateway <<external system>>
  component "Telegram Bot API" as TelegramAPI <<external system>>
  component "3x-ui API\n(node-level control-plane)" as XUI <<external system>>
  component "Узел доступа\n(Xray / data-plane)" as DataPlane <<external system>>

  PaymentGateway -[hidden]down- TelegramAPI
  TelegramAPI -[hidden]down- XUI
  XUI -[hidden]down- DataPlane
}

package "Инфраструктурный контур" as Infra {
  component "Ansible-роли\n(server_baseline,\ncertbot_setup,\nxui_app,\nnginx_proxy,\nbot_server)" as Ansible <<infrastructure>>
}

Frontend -right-> Backend : HTTP API

Backend ..> Shared
Bot ..> Shared
Alembic ..> Shared

Service -right-> InfraDeps : доменное состояние,\nкэш и очереди

Backend -right-> XUI
Bot -right-> XUI
Bot -right-> TelegramAPI : сообщения
PaymentGateway -left-> Backend : webhook

Ansible ..up.> Service : подготовка хоста
Ansible ..right.> XUI : настройка 3x-ui
Ansible ..right.> DataPlane : подготовка узла

XUI -down-> DataPlane

legend bottom
  Обзорная angled-версия: повторяющиеся связи Backend/Bot/Alembic с PostgreSQL
  и Redis сведены к архитектурной зависимости сервисного уровня от инфраструктурных
  зависимостей. Конкретные связи раскрываются в детализированной версии диаграммы
  или в тексте подраздела.
  Shared не является сетевым сервисом; пользовательский трафик не проходит через
  backend, frontend или Telegram-бот.
endlegend

@enduml
